ADDR=":8080"
EXTERNAL_URL="localhost:8080"
FRONTEND_URL="http://localhost:4000"
#Seprate by "," with no space in between
CORS_ALLOWED_ORIGINS="http://localhost:4000,http://localhost:5174"
ENV="dev"

DB_DSN="postgres://admin:adminpass@localhost/gosocial?sslmode=disable&pool_max_conns=30&pool_max_conn_idle_time=15m"
DB_MIGRATION_DSN="postgres://admin:adminpass@localhost/gosocial?sslmode=disable"

# it's not user:pass and it's :pass because we don't have a user for redis. just a password set
CACHE_DSN="redis://:adminpass@localhost:6379/0?protocol=3"
CACHE_USER_EXPIRY="10s"
CACHE_ROLE_EXPIRY="24h"

MAIL_FROM_EMAIL=""
MAIL_EXPIRY="72h"
MAIL_DOMAIN=""

MAILGUN_API_KEY=""

JWT_SECRET=""
JWT_ISSUER="gosocial"
JWT_AUDIENCE="gosocial"

RATELIMITER_ENABLED="false"
RATELIMITER_REQUESTS_PER_TIME_FRAME="100"
